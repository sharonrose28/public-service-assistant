PORT=3000
HOST=127.0.0.1
# local: account-free rules; strands: optional local Strands + Ollama; bedrock: AWS inference.
AI_PROVIDER=local
STRANDS_URL=http://127.0.0.1:8001
# Only used with AI_PROVIDER=bedrock. A deployed Lambda uses its IAM execution role.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
# Optional for local Bedrock development; never put this in a deployment template.
AWS_BEARER_TOKEN_BEDROCK=
